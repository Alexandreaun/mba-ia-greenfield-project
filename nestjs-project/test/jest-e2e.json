{
  "moduleFileExtensions": ["js", "mjs", "cjs", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.[mc]js$": [
      "babel-jest",
      { "plugins": ["@babel/plugin-transform-modules-commonjs"] }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!pg-boss|serialize-error|non-error|rrule-temporal|temporal-spec|@tus|srvx)"],
  "setupFiles": ["dotenv/config"]
}
